DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
# Keep False except while debugging locally. With False, custom 404/500 pages are shown.
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=tracked
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-local-postgres-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# Comma-separated, needed only when the site runs behind a domain, e.g. https://tracked.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set both to True only when the site is served over HTTPS.
DJANGO_SECURE_COOKIES=False
DJANGO_SECURE_SSL_REDIRECT=False
